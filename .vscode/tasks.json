{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run incident API",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				".\\IncidentManagement.Api",
				"--launch-profile",
				"http",
				"--no-build"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run React UI",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				".\\client",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}